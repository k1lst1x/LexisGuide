{
  "$schema": "https://schema.agentcore.aws.dev/v1/agentcore.json",
  "name": "LexisGuide",
  "version": 1,
  "managedBy": "CDK",
  "tags": {
    "agentcore:created-by": "agentcore-cli",
    "agentcore:project-name": "LexisGuide",
    "Application": "LexisGuide"
  },
  "runtimes": [
    {
      "name": "LexisGuideLegalReviewer",
      "build": "CodeZip",
      "entrypoint": "main.py",
      "codeLocation": "agentcore/runtime",
      "runtimeVersion": "PYTHON_3_13",
      "networkMode": "PUBLIC",
      "protocol": "HTTP",
      "envVars": [
        {"name": "AWS_REGION", "value": "us-east-1"},
        {"name": "BEDROCK_MODEL_ID", "value": "us.amazon.nova-lite-v1:0"}
      ]
    }
  ],
  "memories": [],
  "credentials": []
}
