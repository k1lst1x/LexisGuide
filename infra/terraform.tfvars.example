# if you add a custom domain.
# callback_urls       = ["http://localhost:5173/auth/callback", "https://k1lst1x.github.io/LexisGuide/auth/callback"]
# logout_urls         = ["http://localhost:5173", "https://k1lst1x.github.io/LexisGuide"]
google_client_id      = ""
google_client_secret  = ""
apple_client_id       = ""
apple_team_id         = ""
apple_key_id          = ""
apple_private_key     = ""
# Create a Secrets Manager secret containing the rotated lawfirm.dev key, then
# set its ARN here. Do not place the key itself in this file.
lawfirm_api_key_secret_arn = ""
