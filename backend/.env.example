AWS_REGION=us-west-2
# Direct Bedrock inference profile used by the review and conversational AI.
# The deployed Lambda receives this from Terraform; set it locally to use the
# AWS credentials in your shell or configured profile.
BEDROCK_MODEL_ID=us.amazon.nova-2-lite-v1:0
ASSISTANT_MODEL_ID=us.amazon.nova-2-lite-v1:0
# Optional AgentCore overrides. Leave blank when using direct Bedrock inference.
AGENTCORE_RUNTIME_ARN=
AGENTCORE_ASSISTANT_RUNTIME_ARN=
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://k1lst1x.github.io
# Used only when AGENTCORE_RUNTIME_ARN is configured. Production gets these from Terraform.
REVIEW_RATE_LIMIT_PER_WINDOW=10
REVIEW_RATE_LIMIT_WINDOW_SECONDS=60

# Optional: point this at a curated Amazon Bedrock Knowledge Base containing
# jurisdiction-specific statutes, regulations, and case law. Never claim the
# corpus is exhaustive; show the returned citations and disclose coverage gaps.
BEDROCK_KNOWLEDGE_BASE_ID=

# Optional lawfirm.dev legal-data source. Set a newly issued key locally only;
# never put a live key in frontend variables or source control. Production uses
# the Secrets Manager ARN.
LAWFIRM_API_KEY=
LAWFIRM_API_KEY_SECRET_ARN=
